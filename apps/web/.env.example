# API base URL (axios + Socket.IO). Local default matches apps/api listen port.
# Deploy: VITE_API_URL=https://your-api-domain.example
VITE_API_URL="http://localhost:3000"

# Required for SSS browser signing (ethers JsonRpcProvider on Sepolia)
VITE_SEPOLIA_RPC_URL="https://ethereum-sepolia.publicnode.com"